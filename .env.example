POSTGRES_USER=fleet
POSTGRES_PASSWORD=fleet
POSTGRES_DB=fleet
DB_PORT=5432

# Первый администратор создаётся при запуске, если в базе нет пользователей.
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin

# Секрет подписи токена входа. Длинная случайная строка. Смена значения разлогинивает всех.
JWT_SECRET=change-me-to-a-long-random-string

BACKEND_PORT=8080
FRONTEND_PORT=3000
# Адрес бэкенда, по которому к нему ходит браузер.
PUBLIC_API_URL=http://localhost:8080

# Навигация Axenta: координаты тягачей и прицепов.
AXENTA_BASE_URL=https://axenta.cloud
AXENTA_USERNAME=
AXENTA_PASSWORD=
