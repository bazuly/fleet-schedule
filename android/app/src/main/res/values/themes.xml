<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Fleet" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">#F9FBFD</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Страница не рисуется под камерой и системными полосами. -->
